# fal.ai key: either set it directly...
# FAL_KEY=
# ...or point at a 1Password secret reference, read with `op read` at run time.
VREA_FAL_OP_REF=op://Private/FAL_KEY/credential

# ElevenLabs key (voice-over, effects, music, word timings): set it, or a 1Password reference.
# ELEVENLABS_API_KEY=
VREA_ELEVENLABS_OP_REF=op://Private/ELEVENLABS_API_KEY/credential

# Pexels key (stock footage and photos): set it, or a 1Password reference.
# PEXELS_API_KEY=
VREA_PEXELS_OP_REF=op://Private/PEXELS_API_KEY/credential
